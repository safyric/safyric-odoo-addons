<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_qc_mtc_document">
    <t t-call="quality_control_mtc_svco.external_layout">
      <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
      <div class="page">
        <div class="oe_structure"/>
        <table class="table-sm table-bordered p-0 m-0">
          <thead>
            <tr>
              <th rowspan="3" width="20%">
                <div class="text-muted font-weight-light" style="font-size:8px;">Customer Name</div>
                <div><span t-field="doc.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': True}"/></div>
              </th>
              <th>
                <div class="text-muted text-nowrap font-weight-light" style="font-size:8px;">PO Number</div>
                <div class="text-nowrap"><span t-field="doc.sale_order_id.client_order_ref"/></div>
              </th>
              <th t-if="doc.project_name">
                <div class="text-muted text-nowrap font-weight-light" style="font-size:8px;">Project Name</div>
                <div><span t-field="doc.project_name"/></div>
              </th>
              <th colspan="2">
                <div class="text-muted text-nowrap font-weight-light" style="font-size:8px;">Safyric Order Number</div>
                <div class="text-nowrap"><span t-field="doc.sale_order_id.name"/></div>
              </th>
              <th colspan="2">
                <div class="text-muted text-nowrap font-weight-light" style="font-size:8px;">Certificate Number</div>
                <div><span t-field="doc.name"/></div>
              </th>
            </tr>
            <tr>
              <th t-att-colspan="'2' if doc.project_name else '1'">
                <div class="text-muted font-weight-light" style="font-size:8px;">Serial/Lot Number(s)</div>
                <div><span t-field="doc.lot_name"/></div>
              </th>
              <th>
                <div class="text-nowrap text-muted font-weight-light" style="font-size:8px;">Line Number</div>
                <div><span t-field="doc.sale_line_id.sequence"/></div>
              </th>
              <th>
                <div class="text-nowrap text-muted font-weight-light" style="font-size:8px;">Item/Tag Number</div>
                <div><span t-field="doc.sale_line_id.item"/></div>
              </th>
              <th colspan="2">
                <div class="text-muted font-weight-light" style="font-size:8px;">Certificate Date</div>
                <div class="text-nowrap"><span t-esc="doc.date.strftime('%A, %B %d, %Y')"/></div>
              </th>
            </tr>
            <tr>
              <t t-set="colspan" t-value="3"/>
              <t t-if="doc.project_name">
                <t t-if="doc.report_show_vendor" t-set="colspan" t-value="2"/>
                <t t-else="" t-set="colspan" t-value="4"/>
              </t>
              <t t-if="doc.report_show_vendor">
                <t t-if="doc.project_name" t-set="colspan" t-value="2"/>
                <t t-else="" t-set="colspan" t-value="1"/>
              </t>
              <th t-att-colspan="colspan">
                <div class="text-muted font-weight-light" style="font-size:8px;">Product Code &amp; Description</div>
                <div><span t-field="doc.description"/></div>
              </th>
              <th>
                <div class="text-muted font-weight-light" style="font-size:8px;">Stock Code</div>
                <div><span t-field="doc.product_id.barcode"/></div>
              </th>
              <th>
                <div class="text-muted font-weight-light" style="font-size:8px;">Quantity</div>
                <div><span class="text-nowrap"><span t-field="doc.quantity"/> <span t-field="doc.product_id.uom_id.name"/></span></div>
              </th>
              <th t-if="doc.report_show_vendor">
                <div class="text-muted font-weight-light" style="font-size:8px;">Manufacturing Location</div>
                <div>
                  <div><span t-field="doc.vendor_id.name"/></div>
                  <div><span t-esc="'%s, %s' % (doc.vendor_id.city, doc.vendor_id.country_id.name)"/></div>
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td colspan="100%">
                <div class="container-fluid p-0">
                  <div class="row">
                    <div t-att-class="'col-8' if doc.notes else 'col-12'">
                      <table class="table-sm table-borderless p-0 m-0" width="100%" t-if="doc.mtc_heat_ids">
                        <thead>
                          <tr>
                            <th colspan="100%" class="text-center">TRACEABILITY TABLE</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr>
                            <td width="25%" class="font-weight-bold">Lot/Serial Number(s)</td>
                            <t t-set="part_ids" t-value="doc.mapped('mtc_heat_ids.part_id')"/>
                            <t t-foreach="part_ids" t-as="part">
                              <td class="font-weight-bold">
                                <div t-field="part.name"/>
                                <t t-set="material" t-value="doc.mtc_heat_ids.filtered(lambda r: r.part_id.id == part.id)[0].material_id"/>
                                <div class="font-italic text-nowrap" t-field="material.name"/>
                              </td>
                            </t>
                          </tr>
                          <t t-set="lot_names" t-value="[]"/>
                          <t t-foreach="doc.mtc_heat_ids" t-as="heat">
                            <t t-set="lot_names" t-value="lot_names+[heat.lot_name]"/>
                          </t>
                          <t t-foreach="sorted(set(lot_names))" t-as="lot">
                            <tr>
                              <td><t t-esc="lot"/></td>
                              <t t-foreach="part_ids" t-as="part">
                                <td>
                                  <t t-set="heat_id" t-value="doc.mtc_heat_ids.filtered(lambda k: k.lot_name == lot and k.part_id.id == part.id)"/>
                                  <span t-if="len(heat_id)!=0" t-esc="heat_id[0].name"/>
                                </td>
                              </t>
                            </tr>
                          </t>
                        </tbody>
                      </table>
                    </div>
                    <div t-if="doc.notes" class="col-4">
                      <table class="table-sm table-borderless p-0 m-0" width="100%">
                        <thead>
                          <tr>
                            <th><span t-field="doc.notes"/></th>
                          </tr>  
                        </thead>
                      </table>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
            <tr>
              <td colspan="100%" id="lot">
                <div class="container-fluid p-0">
                  <div class="row">
                    <div class="col-auto" id="test">
                    </div>
                    <div class="col-auto" t-if="doc.inspection_ids">
                      <table class="table-sm table-borderless p-0 m-0" width="100%">
                        <thead>
                          <tr>
                            <th colspan="100%" class="text-center">INSPECTIONS</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr>
                            <td id="inspection">
                              <div class="container-fluid p-0">
                                <t t-foreach="doc.inspection_ids" t-as="line">
                                  <t t-set="cats" t-value="[]"/>
                                  <t t-foreach="line.inspection_lines" t-as="inspection">
                                    <t t-set="cats" t-value="cats+[inspection.test_category]"/>
                                  </t>
                                  <t t-foreach="sorted(set(cats), key=lambda k: k.id)" t-as="cat">
                                    <div class="row">
                                      <div class="col-12">
                                        <div class=""><span class="font-weight-bold" t-field="cat.name"/></div>
                                        <t t-foreach="line.inspection_lines.filtered(lambda k: k.test_category.id == cat.id)" t-as="inspection">
                                          <div class="col-auto bg-light border p-1">
                                            <span>
                                              <span t-field="inspection.name"/>
                                              <t t-if="inspection.success"><i class="text-success far fa-check-circle"></i></t>
                                              <t t-else=""><i class="text-danger far fa-times-circle"></i></t>
                                            </span>
                                          </div>
                                        </t>
                                      </div>
                                    </div>
                                  </t>
                                </t>
                              </div>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
            <tr t-if="doc.mtc_line_ids">
              <td colspan="100%">
                <div class="container-fluid p-0">
                  <div class="row">
                    <div class="col">
                      <table class="table-sm table-borderless p-0 m-0" width="100%">
                        <thead>
                          <tr>
                            <th colspan="100%" class="text-center">MATERIAL CONDITIONS &amp; TEST RESULTS</th>
                          </tr>
                        </thead>
                        <tbody>
                          <t t-foreach="doc.mtc_line_ids" t-as="line">
                            <tr>
                              <td>
                                <div class="text-nowrap"><strong>Heat: <span t-field="line.name"/></strong></div>
                                <div class="text-nowrap text-italic text-muted"><span t-field="line.material_id.name"/></div>
                              </td>
                              <td>
                                <div class="container-fluid p-0 m-0">
                                  <div class="row">
                                    <t t-set="cats" t-value="[]"/>
                                    <t t-foreach="line.inspection_id.inspection_lines" t-as="inspection">
                                      <t t-set="cats" t-value="cats+[inspection.test_category]"/>
                                    </t>
                                    <div class="col">
                                      <div class="row">
                                        <t t-foreach="sorted(set(cats), key=lambda k: k.id)" t-as="cat">
                                          <div class="col-auto" t-if="len(set(cats)) &lt; 2">
                                            <span class="font-weight-bold" t-field="cat.name"/>
                                            <div class="container-fluid">
                                              <div class="row">
                                                <t t-foreach="line.inspection_id.inspection_lines.filtered(lambda k: k.test_category.id == cat.id and k.code)" t-as="inspection">
                                                  <div t-if="inspection.quantitative_value or inspection.qualitative_value" class="col-auto bg-white border p-1">
                                                    <span t-field="inspection.code"/>
                                                    <span class="badge badge-primary">
                                                      <span t-if="inspection.question_type == 'quantitative'" t-esc="'%g' % (float(inspection.quantitative_value))"/>
                                                      <span t-field="inspection.test_uom_id"/>
                                                    </span>
                                                    <div>
                                                      <small><span class="text-muted" t-field="inspection.name"/></small>
                                                    </div>
                                                    <div t-if="inspection.question_type == 'quantitative'">
                                                      <small class="font-italic text-muted font-weight-light">
                                                        <t t-if="inspection.test_line.value_criteria == 'upper'">
                                                          <span>&#8804; <span t-esc="'%g' % (float(inspection.max_value))"/><span t-field="inspection.test_uom_id"/></span>
                                                        </t>
                                                        <t t-elif="inspection.test_line.value_criteria == 'lower'">
                                                          <span>&#8805; <span t-esc="'%g' % (float(inspection.min_value))"/><span t-field="inspection.test_uom_id"/></span>
                                                        </t>
                                                        <t t-else="">
                                                          <span t-esc="'%g' % (float(inspection.min_value))"/>-<span t-esc="'%g' % (float(inspection.max_value))"/>
                                                          <span t-field="inspection.test_uom_id"/>
                                                        </t>
                                                      </small>
                                                    </div>
                                                  </div>
                                                </t>
                                              </div>
                                            </div>
                                          </div>
                                        </t>
                                      </div>
                                      <div class="row">
                                        <t t-foreach="sorted(set(cats), key=lambda k: k.id)" t-as="cat">
                                          <div class="col-auto" t-if="len(set(cats)) &gt; 1">
                                            <span class="font-weight-bold" t-field="cat.name"/>
                                            <div class="container-fluid">
                                              <div class="row">
                                                <t t-foreach="line.inspection_id.inspection_lines.filtered(lambda k: k.test_category.id == cat.id and k.code)" t-as="inspection">
                                                  <div t-if="inspection.quantitative_value or inspection.qualitative_value" class="col-auto bg-white border p-1">
                                                    <span t-field="inspection.code"/>
                                                    <span class="badge badge-primary">
                                                      <span t-if="inspection.question_type == 'quantitative'" t-esc="'%g' % (float(inspection.quantitative_value))"/>
                                                      <span t-field="inspection.test_uom_id"/>
                                                    </span>
                                                    <div>
                                                      <small><span class="text-muted" t-field="inspection.name"/></small>
                                                    </div>
                                                    <div t-if="inspection.question_type == 'quantitative'">
                                                      <small class="font-italic text-muted font-weight-light">
                                                        <t t-if="inspection.test_line.value_criteria == 'upper'">
                                                          <span>&#8804; <span t-esc="'%g' % (float(inspection.max_value))"/><span t-field="inspection.test_uom_id"/></span>
                                                        </t>
                                                        <t t-elif="inspection.test_line.value_criteria == 'lower'">
                                                          <span>&#8805; <span t-esc="'%g' % (float(inspection.min_value))"/><span t-field="inspection.test_uom_id"/></span>
                                                        </t>
                                                        <t t-else="">
                                                          <span t-esc="'%g' % (float(inspection.min_value))"/>-<span t-esc="'%g' % (float(inspection.max_value))"/>
                                                          <span t-field="inspection.test_uom_id"/>
                                                        </t>
                                                      </small>
                                                    </div>
                                                  </div>
                                                </t>
                                              </div>
                                            </div>
                                          </div>
                                        </t>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </td>
                            </tr>
                          </t>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          </tbody>
          <tfoot t-if="doc.statement">
            <tr>
              <td colspan="100%">
                <table class="table-sm table-borderless p-0 m-0">
                  <thead>
                    <tr>
                      <th colspan="3" class="text-center">STATEMENT OF COMPLIANCE</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td width="60%"><span t-field="doc.statement"/></td>
                      <td width="20%"/>
                      <td width="20%" class="align-middle text-center font-italic font-weight-bold">
                        Authorized Signature
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>      
    </t>
  </template>

  <template id="report_qc_mtc">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="quality_control_mtc_svco.report_qc_mtc_document" t-lang="doc.partner_id.lang"/>
      </t>
    </t>
  </template>
</odoo>

