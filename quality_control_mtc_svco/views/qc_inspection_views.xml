<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="qc_inspection_form_view" model="ir.ui.view">
	  <field name="name">qc.inspection.form</field>
	  <field name="model">qc.inspection</field>
	  <field name="inherit_id" ref="quality_control.qc_inspection_form_view"/>
	  <field name="arch" type="xml">
	    <field name="product_id" position="after">
		  <field name="material_id" options="{'no_create': True, 'no_create_edit': True}"
                    attrs="{'invisible': [('inspection_type', '!=', 'material')]}"/>
		  <field name="heat_code"
		    attrs="{'required': [('inspection_type', '=', 'material')], 'invisible': [('inspection_type', '!=', 'material')]}"/>
	    </field>
	  </field>
  </record>
</odoo>
