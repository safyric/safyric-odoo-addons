<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_quality_control_configuration_mtc" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.quality.control.mtc</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="quality_control.view_quality_control_configuration"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@id='quality_control_setting']" position="inside">
        <div class="col-12 col-lg-6 o_setting_box" title="Set a default statement for use in MTC">
          <div class="o_setting_right_pane">
            <label for="mtc_statement" string="Default MTC Statement"/>
            <div class="text-muted">
             Use this as the default statement for Mill Test Certificate
              <div>
                <div class="content-group">
                  <div class="mt16">
                    <field name="mtc_statement" placeholder="Insert your statement here..."/>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>

